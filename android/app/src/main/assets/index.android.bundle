ath_explain:"B\u1ecf qua \u0111\u1ec3 s\u1eed d\u1ee5ng m\u1eb7c \u0111\u1ecbnh ({default})",ms_help:"Tr\u1ee3 gi\xfap",ms_help_title:" C\xe1ch Multisig ho\u1ea1t \u0111\u1ed9ng: m\u1ed9t s\u1ed1 th\u1ee7 thu\u1eadt ",ms_help_text:"M\u1ed9t v\xed s\u1eed d\u1ee5ng nhi\u1ec1u kho\xe1 \u0111\u1ec3 t\u0103ng an to\xe0n ho\u1eb7c chia s\u1ebb quy\u1ec1n gi\xe1m s\xe1t",ms_help_title1:"N\u1ebfn c\xf3 nhi\u1ec1u thi\u1ebft b\u1ecb.",ms_help_1:"Vault s\u1ebd ho\u1ea1t \u0111\u1ed9ng v\u1edbi c\xe1c \u1ee9ng d\u1ee5ng Bluewallet kh\xe1c v\xe0 v\xed t\u01b0\u01a1ng th\xedch PSBT nh\u01b0 Electrum, Spectre, Coldcard, Cobo Vault, v.v.",ms_help_title2:"\u0110ang ch\u1ec9nh s\u1eeda nh\u1eefng kho\xe1",ms_help_2:"B\u1ea1n c\xf3 th\u1ec3 t\u1ea1o t\u1ea5t c\u1ea3 c\xe1c kh\xf3a Vault trong thi\u1ebft b\u1ecb n\xe0y \u0111\u1ec3 x\xf3a ho\u1eb7c ch\u1ec9nh s\u1eeda sau. C\xf3 t\u1ea5t c\u1ea3 c\xe1c ph\xedm tr\xean c\xf9ng m\u1ed9t thi\u1ebft b\u1ecb c\xf3 an to\xe0n gi\u1ed1ng nh\u01b0 v\xed bitcoin th\xf4ng th\u01b0\u1eddng.",ms_help_title3:"C\xe1c b\u1ea3n sao l\u01b0u Vault",ms_help_3:"Tr\xean c\xe1c t\xf9y ch\u1ecdn v\xed, b\u1ea1n s\u1ebd th\u1ea5y b\u1ea3n sao l\u01b0u Vault v\xe0 b\u1ea3n sao l\u01b0u \u201cch\u1ec9 xem\u201d. B\u1ea3n sao l\u01b0u n\xe0y gi\u1ed1ng nh\u01b0 m\u1ed9t b\u1ea3n \u0111\u1ed3 v\xe0o v\xed c\u1ee7a b\u1ea1n. N\xf3 c\u1ea7n thi\u1ebft cho vi\u1ec7c ph\u1ee5c h\u1ed3i v\xed trong tr\u01b0\u1eddng h\u1ee3p b\u1ea1n m\u1ea5t m\u1ed9t trong nh\u1eefng h\u1ea1t gi\u1ed1ng c\u1ee7a m\xecnh.",ms_help_title4:"\u0110ang nh\u1eadp c\xe1c Vault",ms_help_4:"\u0110\u1ec3 nh\u1eadp m\u1ed9t Multisig, h\xe3y s\u1eed d\u1ee5ng t\u1ec7p sao l\u01b0u c\u1ee7a b\u1ea1n v\xe0 t\xednh n\u0103ng nh\u1eadp. N\u1ebfu b\u1ea1n ch\u1ec9 c\xf3 nh\u1eefng h\u1ea1t gi\u1ed1ng v\xe0 XPUB, b\u1ea1n c\xf3 th\u1ec3 s\u1eed d\u1ee5ng n\xfat Nh\u1eadp ri\xeang l\u1ebb khi t\u1ea1o c\xe1c kho\xe1 Vault.",ms_help_title5:"Ch\u1ebf \u0111\u1ed9 n\xe2ng cao",ms_help_5:"Theo m\u1eb7c \