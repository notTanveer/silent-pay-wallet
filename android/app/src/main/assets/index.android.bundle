u0dc0\u0dad\u0dca \u0d9c\u0db1\u0dd4\u0daf\u0dd9\u0db1\u0dd4\u0dc0\u0d9a\u0dca \u0d85\u0db4\u0dd2 \u0db1\u0dd2\u0dbb\u0dca\u0db8\u0dcf\u0dab\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0dd9\u0db8\u0dd4. \u0db8\u0dd4\u0dc5\u0dd4 \u0d9c\u0dcf\u0dc3\u0dca\u0dad\u0dd4\u0dc0 \u0db1\u0dd2\u0dba\u0db8 \u0d9c\u0dcf\u0dc3\u0dca\u0dad\u0dd4\u0dc0\u0da7 \u0dc0\u0da9\u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0db1 \u0db6\u0dd0\u0dc0\u0dd2\u0db1\u0dca \u0d91\u0dba \u0dc0\u0dda\u0d9c\u0dba\u0dd9\u0db1\u0dca \u0d9a\u0dd0\u0dab\u0dd3\u0db8\u0dca \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba. \u0db8\u0dd9\u0dba \u0dc4\u0dd0\u0db3\u0dd2\u0db1\u0dca\u0dc0\u0dd9\u0db1\u0dca\u0db1\u0dda CPFP - \u0daf\u0dd9\u0db8\u0dcf\u0db4\u0dd2\u0dba\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0dc5\u0db8\u0dba\u0dcf \u0d9c\u0dd9\u0dc0\u0dba\u0dd2.",cpfp_no_bump:"\u0db8\u0dd9\u0db8 \u0d9c\u0db1\u0dd4\u0daf\u0dd9\u0db1\u0dd4\u0dc0 \u0db6\u0db8\u0dca\u0db4\u0dca \u0d9a\u0dc5 \u0db1\u0ddc\u0dc4\u0dd0\u0d9a.",cpfp_title:"\u0db6\u0db8\u0dca\u0db4\u0dca \u0d9c\u0dcf\u0dc3\u0dca\u0dad\u0dd4\u0dc0 (CPFP)",details_balance_hide:"Hide Balance",details_balance_show:"\u0dc1\u0dda\u0dc2\u0dba \u0db4\u0dd9\u0db1\u0dca\u0dc0\u0db1\u0dca\u0db1",details_copy:"\u0db4\u0dd2\u0da7\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1",details_copy_block_explorer_link:"\u0db6\u0dca\u0dbd\u0ddc\u0d9a\u0dca \u0d91\u0d9a\u0dca\u0dc3\u0dca\u0db4\u0dca\u0dbd\u0ddd\u0dbb\u0dbb\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0d9a\u0dba \u0db4\u0dd2\u0da7\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1",details_copy_note:"\u0dc3\u0da7\u0dc4\u0db1 \u0db4\u0dd2\u0da7\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1",details_copy_txid:"\u0d9c\u0db1\u0dd4\u0daf\u0dd9\u0db1\u0dd4 \u0dc4\u0dd0\u0db3\u0dd4\u0db1\u0dd4\u0db8\u0dca\u0db4\u0dad \u0db4\u0dd2\u0da7\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1",details_from:"\u0d86\u0daf\u0dcf\u0db1\u0dba",details_inputs:"\u0dba\u0dd9\u0daf\u0dc0\u0dd4\u0db8\u0dca",details_outputs:"\u0db4\u0dca\u200d\u0dbb\u0