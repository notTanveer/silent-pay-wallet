o z geslom",encrypt_title:"Varnost",encrypt_tstorage:"Shramba",encrypt_use:"Uporabi {type}",encrypt_use_expl:"{type} bo uporabljen za potrditev va\u0161e identitete pred izvedbo transakcije, odklepanjem, izvozom ali brisanjem denarnice. {type} ne bo uporabljen za odklepanje \u0161ifrirane shrambe.",general:"Splo\u0161no",general_continuity:"Neprekinjenost",general_continuity_e:"Ko je omogo\u010deno, si boste lahko ogledali izbrane denarnice in transakcije z uporabo va\u0161ih drugih naprav povezanih z Apple iCloud.",groundcontrol_explanation:"GroundControl je brezpla\u010den odprtokoden stre\u017enik potisnih obvestil za bitcoin denarnice. Da se ne zana\u0161ate na BlueWallet infrastrukturo, lahko namestite svoj stre\u017enik GroundControl in tukaj dodate njegov URL. Pustite prazno, za uporabo privzetega.",header:"Nastavitve",language:"Jezik",last_updated:"Posodobljeno",language_isRTL:"Za spremembo orientacije pisave je potreben ponovni zagon aplikacije.",lightning_saved:"Spremembe so bile uspe\u0161no shranjene",lightning_settings:"Lightning Nastavitve",network:"Omre\u017eje",network_broadcast:"Objavi transakcijo",network_electrum:"Electrum Stre\u017enik",not_a_valid_uri:"Neveljaven URI",notifications:"Obvestila",open_link_in_explorer:"Odpri v raziskovalcu blokov",password:"Geslo",plausible_deniability:"Verodostojno zanikanje",privacy:"Zasebnost",privacy_read_clipboard:"Branje odlo\u017ei\u0161\u010da",privacy_system_settings:"Sistemske nastavitve",privacy_quickactions:"Bli\u017enjice",privacy_clipboard_explanation:"Prika\u017ei bli\u017enjice, \u010de je v odlo\u017ei\u0161\u010du najden naslov ali ra\u010dun.",privacy_do_not_track:"Onemogo\u010di analitiko",privacy_do_not_track_explanation:"Informacije o zmogljivosti in zanesljivosti ne bodo poslane v analizo.",rate:"Te\u010daj",selfTest:"Samotestiranje",save:"Shrani",saved:"Shranjeno",total_balance:"Skupno stanje",total_balance_explanation:"Prika\u017ei skupno stanje vseh denarnic na pripomo\u010dkih na doma\u01