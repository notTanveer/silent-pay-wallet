db1",details_total_exceeds_balance:"\u0dba\u0dd0\u0dc0\u0dd3\u0db8\u0dda \u0db8\u0dd4\u0daf\u0dbd \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0dc1\u0dda\u0dc2\u0dba \u0d89\u0d9a\u0dca\u0db8\u0dc0\u0dba\u0dd2.",details_total_exceeds_balance_frozen:"\u0dba\u0dd0\u0dc0\u0dd3\u0db8\u0dda \u0db8\u0dd4\u0daf\u0dbd \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0dc1\u0dda\u0dc2\u0dba \u0d89\u0d9a\u0dca\u0db8\u0dc0\u0dba\u0dd2. \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dbd \u0d9a\u0dcf\u0dc3\u0dd2 \u0db6\u0dd0\u0dc4\u0dd0\u0dbb \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db6\u0dc0 \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dc0\u0dd9\u0db1\u0dca \u0dc3\u0dbd\u0d9a\u0db1\u0dca\u0db1.",details_unrecognized_file_format:"\u0dc4\u0db3\u0dd4\u0db1\u0dcf \u0db1\u0ddc\u0d9c\u0dad\u0dca \u0d9c\u0ddc\u0db1\u0dd4 \u0d86\u0d9a\u0dd8\u0dad\u0dd2\u0dba",details_wallet_before_tx:"\u0d9c\u0db1\u0dd4\u0daf\u0dd9\u0db1\u0dd4\u0dc0\u0d9a\u0dca \u0db1\u0dd2\u0dbb\u0dca\u0db8\u0dcf\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0db4\u0dd9\u0dbb, \u0d94\u0db6 \u0db8\u0dd4\u0dbd\u0dd2\u0db1\u0dca\u0db8 \u0db6\u0dd2\u0da7\u0dca\u0d9a\u0ddc\u0dba\u0dd2\u0db1\u0dca \u0db4\u0dc3\u0dd4\u0db8\u0dca\u0db6\u0dd2\u0dba\u0d9a\u0dca \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba.",dynamic_init:"\u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8",dynamic_next:"\u0d8a\u0dc5\u0d9f",dynamic_prev:"\u0d9a\u0dbd\u0dd2\u0db1\u0dca",dynamic_start:"\u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dbb\u0db1\u0dca\u0db1",dynamic_stop:"\u0db1\u0dc0\u0dad\u0dca\u0dc0\u0db1\u0dca\u0db1",fee_10m:"\u0db8\u0dd3\u0da7\u0dbb\u0dca 10",fee_1d:"\u0daf\u0dc0\u0dc3\u0dca 1",fee_3h:"\u0db4\u0dd0\u0dba 3",fee_custom:"\u0da0\u0dcf\u0dbb\u0dd2\u0dad\u0dca\u200d\u0dbb\u0dba",fee_fast:"\u0d89\u0d9a\u0dca\u0db8\u0dab\u0dd2\u0db1\u0dca",fee_medium:"\u0db8\u0db0\u0dca\u200d\u0dba\u0db8",fee_satvbyte:"\u0dc3\u0dad\u0ddc\u0dc2\u0dd2/\u0dc0\u0dd3\u0db6\u0dba\u0dd2\u0da7\u0dca \u0dc4\u0dd2",fee_slow:"\u0db8\u0db1\u0dca\u0daf\u0d9c\u0dcf\u0db8\u0dd3",header:"\u0dba\u0dc