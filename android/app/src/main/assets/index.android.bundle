xplanation:"GroundControl \u2014 \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0439 \u0441\u0435\u0440\u0432\u0435\u0440 push-\u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0439. \u0423\u043a\u0430\u0436\u0438\u0442\u0435 \u0441\u0432\u043e\u0439 URL, \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0441\u0435\u0440\u0432\u0435\u0440 BlueWallet.",header:"\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438",language:"\u042f\u0437\u044b\u043a",last_updated:"\u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0435 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435",language_isRTL:"\u041f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435 BlueWallet \u0434\u043b\u044f \u0441\u043c\u0435\u043d\u044b \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u044f\u0437\u044b\u043a\u0430.",license:"\u041b\u0438\u0446\u0435\u043d\u0437\u0438\u044f",lightning_error_lndhub_uri:"\u041d\u0435\u0432\u0435\u0440\u043d\u044b\u0439 LNDhub URI",lightning_error_lndhub_uri_tor:"\u041d\u0435\u0432\u0435\u0440\u043d\u044b\u0439 LNDhub URI. \u0423\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044c, \u0447\u0442\u043e Orbot \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0451\u043d, \u0438 \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0441\u043d\u043e\u0432\u0430.",lightning_saved:"\u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u044b.",lightning_settings:"\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 Lightning",lightning_settings_explain:"\u0427\u0442\u043e\u0431\u044b \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u044c\u0441\u044f \u043a \u0441\u0432\u043e\u0435\u0439 LND \u043d\u043e\u0434\u0435, \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 LNDhub \u0438 \u0443\u043a\u0430\u0436\u0438\u0442\u0435 \u0435\u0433\u043e URL. \u041d\u043e\u0432\u044b\u0435 \u043a\u043e\u